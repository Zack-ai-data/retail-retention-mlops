# Copy to .env (git-ignored) and change the password.
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=retail_dw
POSTGRES_PORT=5432

# Airflow (only needed for `docker compose up -d airflow-apiserver`). There are no working defaults:
# the airflow-init service refuses to run while these are empty.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Encrypts connections and variables stored in Airflow. Generate one:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Signs the tokens the Airflow services use to talk to each other. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=

# Monitoring (only needed for `docker compose --profile monitoring up -d`). There are no working
# defaults: Grafana and grafana-db-init refuse to start while these are empty.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# The password of the read-only Postgres login Grafana uses (created by grafana-db-init). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_DB_PASSWORD=
# Where Grafana sends alerts: a Slack incoming webhook for one channel (Slack > api.slack.com/apps >
# Create New App > Incoming Webhooks). It is a secret: anyone with it can post to the channel.
# Optional: without it alerts are still evaluated and shown in Grafana, just not delivered.
ALERT_WEBHOOK_URL=

# API access control. Leave API_KEY empty on your own machine (the API is then open). Set it for
# anything reachable by others: every route but /health, /metrics and the docs then needs it in the
# X-API-Key header. API_ADMIN_KEY alone may reload the models; keep it to yourself. Generate each:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=
API_ADMIN_KEY=
# Set to 0 on a public deployment, to hide the dashboard's "Reload models" button.
DASHBOARD_ALLOW_RELOAD=1
