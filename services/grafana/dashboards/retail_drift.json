          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT column_name AS column, round(psi::numeric, 3) AS psi, status FROM ml.monitor_drift WHERE snapshot_date = (SELECT max(snapshot_date) FROM ml.monitor_drift) ORDER BY psi DESC"
        }
