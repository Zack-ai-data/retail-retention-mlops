    {
      "id": 7,
      "type": "table",
      "title": "Every monitored column, latest snapshot",
      "description": "PSI of each model input and of the churn probability. The status is written as well as coloured. Left out because they say nothing about customers: the three calendar columns (one value for the whole snapshot) and tenure (it grows with how long the dataset has existed). Each snapshot is compared with the snapshot about a year earlier, so the same time of year is compared with the same time of year and the seasons do not count as drift.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-warehouse"
