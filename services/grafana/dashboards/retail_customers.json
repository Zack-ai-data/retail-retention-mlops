          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT snapshot_date::timestamp AS time, churn_rate AS \"churn rate\" FROM ml.monitor_snapshot_summary WHERE churn_rate IS NOT NULL ORDER BY 1"
