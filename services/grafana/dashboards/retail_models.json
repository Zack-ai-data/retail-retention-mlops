          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT version::text AS version, max(value) FILTER (WHERE metric = 'test_spearman') AS \"model\", max(value) FILTER (WHERE metric = 'baseline_naive_test_spearman') AS \"naive forecast\" FROM ml.monitor_model_metrics WHERE model_name = 'retail-value-regressor' GROUP BY version HAVING max(value) FILTER (WHERE metric = 'test_spearman_vs_naive_gain') IS NOT NULL ORDER BY version"
        }
