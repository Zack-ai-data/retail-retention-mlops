    {
      "id": 6,
      "type": "barchart",
      "title": "Value model: total bias, by version",
      "description": "Predicted total spend against actual, in percent (0 is unbiased). The promotion gate requires the absolute bias to be at most 40%. The test snapshot follows the holiday peak, so every forecast from a year of earlier data runs low. Versions that were not evaluated against a baseline with a confidence interval are left out: their numbers were measured differently and would not compare.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "retail-warehouse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 26
